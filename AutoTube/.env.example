# ---------------- AutoTube AI configuration ----------------
# Copy to .env and edit. Restart AutoTube after changes. Every service here is FREE; leave keys empty to skip.

# Server (keep 127.0.0.1 so the dashboard is only reachable from this PC)
AUTOTUBE_HOST=127.0.0.1
AUTOTUBE_PORT=8000

# Local AI (Ollama). Bigger models write better but are slower on CPU: qwen2.5:3b (default), llama3.2:3b, qwen2.5:7b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Quality model for scripts/SEO/titles (slower on CPU, much better writing)
OLLAMA_MODEL_WRITER=qwen2.5:7b

# Wikimedia asks API clients to include contact info (email or URL) in the User-Agent. Optional but recommended
# if you see rate-limit (429) messages for Wikimedia images.
WIKIMEDIA_CONTACT=

# Optional: Gemini API free tier (https://aistudio.google.com/apikey). Do NOT enable billing on that project.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DAILY_REQUEST_BUDGET=40

# Optional: stock footage (free keys)
# https://www.pexels.com/api/   (200 req/hour, 20k/month)
PEXELS_API_KEY=
PEXELS_HOURLY_BUDGET=150
# https://pixabay.com/api/docs/ (100 req/minute)
PIXABAY_API_KEY=
PIXABAY_DAILY_BUDGET=500

# Narration voice (files in data/voices). Others: https://huggingface.co/rhasspy/piper-voices
PIPER_VOICE=en_US-lessac-medium

# ---- YouTube / Google OAuth (single-user, this PC only) ----
# Your own Google OAuth "Web application" client. The dashboard's one-time setup wizard (YouTube page) fills these in.
# Your personal sign-in (refresh token) is NOT stored here: it is encrypted with Windows DPAPI in the database.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorised redirect URI" on that client (change only if you change AUTOTUBE_PORT)
GOOGLE_REDIRECT_URI=http://localhost:8000/api/youtube/oauth/callback

# Default project quota is 10,000 units/day. Per-call costs have changed several times (2025-2026), so check
# "Quotas" for YouTube Data API v3 in Google Cloud Console and adjust if needed.
YOUTUBE_DAILY_QUOTA=10000
YOUTUBE_COST_INSERT=100
YOUTUBE_COST_THUMBNAIL=50
YOUTUBE_COST_LIST=1

# Optional overrides if tools are installed elsewhere
FFMPEG_PATH=
FFPROBE_PATH=
